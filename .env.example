# SwarmGuard needs NO API keys in mock mode (the default). Copy to .env only if you change defaults.
# .env is gitignored. Never commit a real key.

# SQLite file written by demo.py and read (read-only) by the API.
SWARMGUARD_DB_PATH=swarmguard_demo.db
SWARMGUARD_LOG_LEVEL=WARNING
SWARMGUARD_APPROVAL_TTL_MINUTES=15
# The API binds to localhost by default. Change only for container use.
SWARMGUARD_API_HOST=127.0.0.1
SWARMGUARD_API_PORT=8000

# Stage 2 evaluation results directory read by the API
SWARMGUARD_RESULTS_DIR=results

# ---- Stage 3: LLM ethics monitors -------------------------------------------------------
# mock (default): deterministic synthetic responses, no network. openai: live, explicit opt-in.
SWARMGUARD_LLM_PROVIDER=mock
# Required for live mode. No default model is ever chosen for you.
OPENAI_API_KEY=
SWARMGUARD_OPENAI_MODEL=gpt-6-luna
SWARMGUARD_LLM_TIMEOUT_SECONDS=300
SWARMGUARD_LLM_MAX_RETRIES=5
SWARMGUARD_LLM_MAX_CONCURRENCY=40
# Same output cap for every monitor (also used for cost reservation)
SWARMGUARD_LLM_MAX_OUTPUT_TOKENS=80000
# Hard cap on provider attempts per run. Required in live mode unless pricing is configured.
SWARMGUARD_LLM_MAX_REQUESTS=1000
# Unset = provider default sampling (recorded). Some models reject temperature: that is recorded as an error.
SWARMGUARD_LLM_TEMPERATURE=
SWARMGUARD_LLM_SEED=
# Local dollar budget, enforced by conservative pre-request reservation. Needs BOTH prices (USD per million tokens)
# for your configured model. Local accounting is NOT a substitute for provider-side billing limits.
SWARMGUARD_MAX_EVALUATION_COST_USD=25.00
SWARMGUARD_PRICE_INPUT_USD_PER_MTOK=0.1
SWARMGUARD_PRICE_OUTPUT_USD_PER_MTOK=0.5

# Stage 4.5 local console (no live provider activation from browser)
# SWARMGUARD_CONSOLE_DB=swarmguard_console.db
# Default is Secure / HttpOnly / SameSite=Strict; use localhost with Vite proxy.
# SWARMGUARD_COOKIE_SECURE=true
# Provision operator hash separately: python setup_console_operator.py
SWARMGUARD_CONSOLE_LIVE_LLM=1
# Stage 5 server ceilings (research commands may request lower bounds).
# No key is needed for mock mode. Live CLI also requires --authorize-live and --max-cost.
SWARMGUARD_STAGE5_MODE=mock
SWARMGUARD_MAX_ADAPTIVE_ITERATIONS=20
SWARMGUARD_MAX_AGENTS=12
SWARMGUARD_MAX_WORKFLOW_STEPS=60
SWARMGUARD_MAX_LLM_REQUESTS=1000
SWARMGUARD_MAX_CONCURRENT_REQUESTS=4
SWARMGUARD_MAX_RUNTIME_SECONDS=1800
