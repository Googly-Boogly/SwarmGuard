# Static React bundle served by Caddy; /api and /ws are proxied to the control service only.
FROM node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM caddy:2.11.9-alpine@sha256:78bd35025c7ba85961dd149ae670315129954e77abe2383ac47c89106b35ade9
COPY deployment/frontend/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv
USER 10003:10003
EXPOSE 8080
