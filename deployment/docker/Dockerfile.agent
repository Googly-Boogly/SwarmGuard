# Untrusted agent runtime: an HTTP client and the agent script only. No SwarmGuard trusted code,
# no keys, no database driver.
FROM python:3.13.18-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONPATH=/app
# Apply current Debian security updates (base digest pinned; package upgrades trade some reproducibility for patches).
RUN apt-get update && apt-get -y upgrade && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY deployment/docker/requirements.agent.lock /tmp/requirements.lock
RUN pip install -r /tmp/requirements.lock \
 && python -m pip uninstall -y pip setuptools \
 && groupadd --system --gid 10002 agent \
 && useradd --system --uid 10002 --gid agent --home-dir /app --shell /usr/sbin/nologin agent
WORKDIR /app
COPY --chown=root:root swarmguard_agent /app/swarmguard_agent
USER 10002:10002
CMD ["python", "-m", "swarmguard_agent.runtime"]
